<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.POSClientApp" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/msp_navy</item>
        <item name="colorPrimaryVariant">@color/msp_navy_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/msp_accent</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:statusBarColor" tools:targetApi="l">?attr/colorPrimaryVariant</item>
        <item name="android:windowBackground">@color/msp_surface</item>
        <item name="materialButtonStyle">@style/Widget.POSClient.Button</item>
    </style>

    <style name="Widget.POSClient.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">10dp</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <style name="Widget.POSClient.Button.Secondary" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">10dp</item>
        <item name="strokeColor">@color/msp_divider</item>
        <item name="android:textColor">@color/msp_navy</item>
        <item name="android:minHeight">44dp</item>
    </style>

    <style name="Widget.POSClient.Button.Text" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/msp_text_secondary</item>
        <item name="android:minHeight">40dp</item>
    </style>

    <style name="TextAppearance.POSClient.Section" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/msp_navy</item>
    </style>

</resources>
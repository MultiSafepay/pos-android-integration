<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="12dp"
    android:fillViewport="true"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/title_msp_intent"
            android:layout_marginTop="20dp"
            android:padding="12dp"
            android:textSize="16sp"
            android:textColor="@color/design_default_color_primary_dark"
            android:gravity="center" />

        <!-- Botón para terminal Sunmi -->
        <Button
            android:id="@+id/sunmipospayment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/pay_with_sunmi"
            android:textSize="14sp"
            android:layout_marginTop="12dp"
            android:visibility="gone" />

        <!-- Botón para terminal SoftPOS -->
        <Button
            android:id="@+id/softpayment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/pay_with_softpos"
            android:textSize="14sp"
            android:layout_marginTop="12dp"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>

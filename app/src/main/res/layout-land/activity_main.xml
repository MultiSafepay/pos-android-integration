<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/msp_surface"
    android:padding="24dp"
    android:gravity="center_horizontal"
    tools:context=".MainActivity">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:text="@string/app_name"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="@color/msp_navy"
        android:gravity="center" />

    <TextView
        android:id="@+id/launcher_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/launcher_subtitle"
        android:textSize="15sp"
        android:textColor="@color/msp_text_secondary"
        android:gravity="center" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/sunmipospayment"
        style="@style/Widget.POSClient.Button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:text="@string/pay_with_sunmi_label"
        android:textSize="16sp"
        android:visibility="gone"
        app:backgroundTint="@color/msp_navy"
        app:cornerRadius="12dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/softpayment"
        style="@style/Widget.POSClient.Button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:text="@string/pay_with_softpos_label"
        android:textSize="16sp"
        android:visibility="gone"
        app:backgroundTint="@color/msp_navy"
        app:cornerRadius="12dp" />

</LinearLayout>
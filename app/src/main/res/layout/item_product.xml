<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="10dp"
    android:paddingEnd="8dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:background="@color/msp_surface_elevated"
    android:layout_marginBottom="6dp">

    <ImageView
        android:id="@+id/product_image"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="10dp"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingEnd="8dp">

        <TextView
            android:id="@+id/product_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/msp_navy"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/product_price"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="13sp"
            android:textColor="@color/msp_text_secondary" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/product_minus"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:minWidth="44dp"
        android:padding="0dp"
        android:text="−"
        android:textSize="18sp"
        android:textColor="@color/msp_navy"
        app:cornerRadius="8dp"
        app:strokeColor="@color/msp_divider" />

    <TextView
        android:id="@+id/product_qty"
        android:layout_width="36dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="0"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/msp_navy" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/product_plus"
        style="@style/Widget.MaterialComponents.Button"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:minWidth="44dp"
        android:padding="0dp"
        android:text="+"
        android:textSize="18sp"
        app:cornerRadius="8dp"
        app:backgroundTint="@color/msp_navy" />

</LinearLayout>
